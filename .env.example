# ─────────────────────────────────────
# Discourse Forum
# ─────────────────────────────────────
DISCOURSE_URL=https://forum.heatpunks.org
# Optional: Only needed if forum requires authentication
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=

# ─────────────────────────────────────
# Forms (Web3Forms)
# ─────────────────────────────────────
# Contact form + summit waitlist each submit directly to Web3Forms from the
# browser, and each has its own separate access key/form in the Web3Forms
# dashboard. Get keys at https://web3forms.com, and set each form's
# notification email in its dashboard settings (not here).
NEXT_PUBLIC_WEB3FORMS_CONTACT_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_WAITLIST_ACCESS_KEY=

# ─────────────────────────────────────
# Umami Analytics
# ─────────────────────────────────────
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_URL=

# ─────────────────────────────────────
# Site Configuration
# ─────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://heatpunks.org
